# Copy this file to .env (repo root) and fill in your account. .env is gitignored.
#
# This file carries the account only. Everything else about the client - shard host and port,
# client version, UO data directory, POI directory, shard/character selection - comes from
# settings.json beside it, and nothing on the command line overrides either.

UO_USER=your_username
UO_PASS=your_password
